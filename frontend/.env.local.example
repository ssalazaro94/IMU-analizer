# Copiar a .env.local y completar con los valores del proyecto de Supabase
# (Project Settings -> API en el dashboard de supabase.com).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del microservicio de análisis de marcha (Render).
NEXT_PUBLIC_ANALYSIS_SERVICE_URL=https://imu-analizer.onrender.com
